{
	"name": "adaptive-extender",
	"version": "0.9.8",
	"description": "Adaptive library for JS/TS development environments",
	"type": "module",
	"main": "./dist/core/index.js",
	"types": "./dist/core/index.d.ts",
	"typesVersions": {
		"*": {
			"core": [ "dist/core/index.d.ts" ],
			"node": [ "dist/node/index.d.ts" ],
			"web": [ "dist/web/index.d.ts" ]
		}
	},
	"exports": {
		".": {
			"import": "./dist/core/index.js",
			"require": "./dist/core/index.js",
			"types": "./dist/core/index.d.ts"
		},
		"./core": {
			"import": "./dist/core/index.js",
			"require": "./dist/core/index.js",
			"types": "./dist/core/index.d.ts"
		},
		"./node": {
			"import": "./dist/node/index.js",
			"require": "./dist/node/index.js",
			"types": "./dist/node/index.d.ts"
		},
		"./web": {
			"import": "./dist/web/index.js",
			"require": "./dist/web/index.js",
			"types": "./dist/web/index.d.ts"
		}
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/eccs0103/adaptive-extender.git"
	},
	"keywords": [ "javascript", "typescript", "extensions", "core", "dom", "node" ],
	"author": "eccs0103",
	"license": "Apache-2.0",
	"bugs": {
		"url": "https://github.com/eccs0103/adaptive-extender/issues"
	},
	"homepage": "https://github.com/eccs0103/adaptive-extender#readme",
	"scripts": {
		"build:core": "tsc -p ./src/core/tsconfig.json",
		"build:node": "tsc -p ./src/node/tsconfig.json",
		"build:web": "tsc -p ./src/web/tsconfig.json",
		"build": "npm run build:core && npm run build:node && npm run build:web",

		"test": "vitest run",
		"coverage": "vitest run --coverage"
	},
	"devDependencies": {
		"@types/jsdom": "^21.1.7",
		"jsdom": "^27.0.0",
		"typescript": "^5.9.2",
		"vitest": "^3.2.4"
	},
	"dependencies": {
		"dotenv": "^17.2.3"
	}
}
