{
	"compilerOptions": {
		"target": "ES2016",
		"module": "CommonJS",
		"lib": [ "ES2016", "WebWorker" ],
		"esModuleInterop": true,
		"allowJs": true,
		"skipLibCheck": true,
		"declaration": true,
		"sourceMap": true,
		"strict": true,
		"forceConsistentCasingInFileNames": true,
	},
	"include": [ "./*.ts" ]
}
